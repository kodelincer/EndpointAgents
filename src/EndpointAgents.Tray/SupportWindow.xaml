<Window
    x:Class="EndpointAgents.Tray.SupportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EndpointAgents.Tray"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
    Messenger layout (RTL): navigation rail and conversation history on the right,
    the open chat in the middle, and a collapsible details pane on the far left.
    FlowDirection mirrors the layout, so logical Left/Right below are physically reversed.
    -->

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" FlowDirection="RightToLeft" Background="Transparent">
        <Grid.Resources>
            <local:BidiFlowDirectionConverter x:Key="BidiFlowDirectionConverter" />
            <local:ConversationStateBrushConverter x:Key="StateBrush" />
            <local:BoolVisibilityConverter x:Key="BoolVisibility" />
            <CollectionViewSource x:Key="GroupedConversations"
                                  Source="{Binding ConversationGroups}"
                                  IsSourceGrouped="True" />

            <!-- Incoming: physically left, small corner at the physical bottom-left. -->
            <DataTemplate x:Key="AssistantMessageTemplate">
                <Border MaxWidth="560" Margin="72,2,14,2" Padding="12,7,12,6"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource EndpointAssistantBubbleBrush}"
                        CornerRadius="14,14,4,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource EndpointAccentTextBrush}" />
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontSize="14" LineHeight="22"
                                   Foreground="{ThemeResource EndpointAssistantBubbleForegroundBrush}"
                                   FlowDirection="{Binding IsRightToLeft, Converter={StaticResource BidiFlowDirectionConverter}}" />
                        <TextBlock Text="{Binding Timestamp}" HorizontalAlignment="Right"
                                   FlowDirection="LeftToRight" FontSize="11"
                                   Foreground="{ThemeResource EndpointBubbleMetadataBrush}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Outgoing: physically right, small corner at the physical bottom-right. -->
            <DataTemplate x:Key="UserMessageTemplate">
                <Border MaxWidth="560" Margin="14,2,72,2" Padding="12,7,12,6"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource EndpointUserBubbleBrush}"
                        CornerRadius="14,14,14,4">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontSize="14" LineHeight="22"
                                   Foreground="{ThemeResource EndpointUserBubbleForegroundBrush}"
                                   FlowDirection="{Binding IsRightToLeft, Converter={StaticResource BidiFlowDirectionConverter}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Timestamp}" FlowDirection="LeftToRight" FontSize="11"
                                       Foreground="{ThemeResource EndpointUserBubbleMetadataForegroundBrush}" />
                            <FontIcon Glyph="&#xE73E;" FontSize="11"
                                      Foreground="{ThemeResource EndpointUserBubbleMetadataForegroundBrush}"
                                      AutomationProperties.Name="ارسال شد" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Run progress: a centred service card, like a messenger system notice. -->
            <DataTemplate x:Key="ProgressTemplate">
                <Border MaxWidth="460" Margin="48,8" HorizontalAlignment="Center"
                        Background="{ThemeResource EndpointServiceBubbleBrush}" CornerRadius="12">
                    <Expander IsExpanded="False" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent" BorderThickness="0">
                        <Expander.Header>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13"
                                        Background="{ThemeResource EndpointAccentBrush}">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="13"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ProgressRing Grid.Column="2" Width="16" Height="16"
                                              IsActive="{Binding IsRunning}"
                                              AutomationProperties.Name="در حال انجام بررسی" />
                            </Grid>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding StatusGlyph}" FontSize="11"
                                                  Foreground="{ThemeResource EndpointAccentTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" FlowDirection="LeftToRight"
                                                   Style="{StaticResource MetadataTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- macOS-style "traffic light" buttons, physically left (last column in RTL), outside the drag region.
             Children run right-to-left, so the physical order is close, minimize, maximize. -->
        <StackPanel x:Name="CaptionButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0" Canvas.ZIndex="1"
                    PointerEntered="CaptionButtons_PointerEntered" PointerExited="CaptionButtons_PointerExited">
            <StackPanel.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button">
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="20" Height="20" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver" />
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Light.Opacity" Value="0.7" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Ellipse x:Name="Light" Width="13" Height="13"
                                             Fill="{TemplateBinding Background}"
                                             Stroke="#26000000" StrokeThickness="0.5" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CaptionGlyphStyle" TargetType="FontIcon">
                    <Setter Property="FontSize" Value="7" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#A0000000" />
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </StackPanel.Resources>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Background="#FF28C840"
                    Click="MaximizeButton_Click" ToolTipService.ToolTip="بزرگ کردن"
                    AutomationProperties.Name="بزرگ کردن">
                <FontIcon x:Name="MaximizeGlyph" Glyph="&#xE740;" Style="{StaticResource CaptionGlyphStyle}" />
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Background="#FFFEBC2E"
                    Click="MinimizeButton_Click" ToolTipService.ToolTip="کوچک کردن"
                    AutomationProperties.Name="کوچک کردن">
                <FontIcon x:Name="MinimizeGlyph" Glyph="&#xE949;" Style="{StaticResource CaptionGlyphStyle}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Background="#FFFF5F57"
                    Click="CloseButton_Click" ToolTipService.ToolTip="بستن"
                    AutomationProperties.Name="بستن">
                <FontIcon x:Name="CloseGlyph" Glyph="&#xE711;" Style="{StaticResource CaptionGlyphStyle}" />
            </Button>
        </StackPanel>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,0" Margin="0,0,90,0" ColumnSpacing="10"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                    Background="{ThemeResource EndpointAccentBrush}">
                <FontIcon Glyph="&#xE95B;" FontSize="12" Foreground="White" />
            </Border>
            <TextBlock Grid.Column="1" Text="دستیار پشتیبانی" FontWeight="SemiBold"
                       FontSize="13" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                <Ellipse x:Name="TitleStatusDot" Width="8" Height="8" Fill="Gray" />
                <TextBlock Text="{Binding StatusLabel}" FontSize="12"
                           Style="{StaticResource MetadataTextStyle}" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact"
                         IsPaneToggleButtonVisible="False"
                         IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                         AlwaysShowHeader="False" SelectionChanged="Navigation_SelectionChanged"
                         AutomationProperties.AutomationId="PrimaryNavigation">
            <NavigationView.Resources>
                <!-- No accent bar beside the selected page icon; the selected tile is filled instead. -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="EndpointSelectedItemBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="EndpointSelectedItemHoverBrush" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="گفتگوها" Tag="Helpdesk"
                                    ToolTipService.ToolTip="گفتگوها">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="وضعیت و کنترل" Tag="Status"
                                    ToolTipService.ToolTip="وضعیت و کنترل">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="گزارش‌ها" Tag="Logs"
                                    ToolTipService.ToolTip="گزارش‌ها">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Background="Transparent">
                <Grid x:Name="HelpdeskPage" SizeChanged="HelpdeskPage_SizeChanged">
                    <!-- The RTL root mirrors SplitView placement; Left renders this pane physically right. -->
                    <SplitView x:Name="ConversationSplitView" PanePlacement="Left"
                               OpenPaneLength="320" CompactPaneLength="0"
                               DisplayMode="Inline" IsPaneOpen="True"
                               PaneBackground="{ThemeResource EndpointConversationRailBrush}">
                        <SplitView.Pane>
                            <Border BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Padding="12,10,10,6" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <AutoSuggestBox x:Name="ConversationSearch"
                                                        PlaceholderText="جستجو در گفتگوها"
                                                        QueryIcon="Find" CornerRadius="18"
                                                        TextChanged="ConversationSearch_TextChanged"
                                                        AutomationProperties.AutomationId="ConversationSearch"
                                                        AutomationProperties.Name="جستجو در گفتگوها" />
                                        <Button x:Name="NewConversationButton" Grid.Column="1"
                                                Click="NewConversation_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Width="36" Height="36" Padding="0" CornerRadius="18"
                                                AutomationProperties.AutomationId="NewConversationButton"
                                                AutomationProperties.Name="شروع گفتگوی جدید"
                                                ToolTipService.ToolTip="گفتگوی جدید">
                                            <FontIcon Glyph="&#xE70F;" FontSize="15" />
                                        </Button>
                                    </Grid>

                                    <SelectorBar x:Name="ConversationFilter" Grid.Row="1" Margin="6,0,6,2"
                                                 SelectionChanged="ConversationFilter_Changed"
                                                 AutomationProperties.AutomationId="ConversationFilter"
                                                 AutomationProperties.Name="فیلتر گفتگوها">
                                        <SelectorBarItem Text="همه" Tag="All" IsSelected="True" />
                                        <SelectorBarItem Text="باز" Tag="Active" />
                                        <SelectorBarItem Text="حل‌شده" Tag="Resolved" />
                                        <SelectorBarItem Text="بسته" Tag="Closed" />
                                    </SelectorBar>

                                    <InfoBar Grid.Row="2" Margin="10,4,10,6"
                                             IsOpen="{Binding HasConversationListError}"
                                             IsClosable="False" Severity="Error"
                                             Title="فهرست گفتگوها دریافت نشد"
                                             Message="{Binding ConversationListError}">
                                        <InfoBar.ActionButton>
                                            <Button Content="تلاش دوباره"
                                                    Click="RefreshConversations_Click" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>

                                    <Grid Grid.Row="3">
                                        <ListView x:Name="ConversationIndex"
                                                  ItemsSource="{Binding Source={StaticResource GroupedConversations}}"
                                                  SelectionMode="Single"
                                                  SelectionChanged="ConversationIndex_SelectionChanged"
                                                  HorizontalContentAlignment="Stretch"
                                                  Padding="0,0,0,8"
                                                  AutomationProperties.AutomationId="ConversationIndex"
                                                  AutomationProperties.Name="فهرست گفتگوهای پشتیبانی">
                                            <ListView.Resources>
                                                <!-- Selection = filled card; the thin accent bar is hidden so it cannot be mistaken for a scrollbar. -->
                                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent" />
                                                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="EndpointSelectedItemBrush" />
                                                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="EndpointSelectedItemHoverBrush" />
                                                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="EndpointSelectedItemHoverBrush" />
                                            </ListView.Resources>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                                                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                                                    <Setter Property="Margin" Value="6,1" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="CornerRadius" Value="10" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" Margin="10,8,10,2"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListView.GroupStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="8,9" ColumnSpacing="12"
                                                          AutomationProperties.Name="{Binding AccessibleName}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Active-conversation marker: full-height bar on the physical right edge, in the status colour. -->
                                                        <Border Grid.ColumnSpan="2" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                                Margin="-8,-9,0,-9" CornerRadius="1.5" IsHitTestVisible="False"
                                                                Background="{Binding State, Converter={StaticResource StateBrush}}"
                                                                Opacity="{Binding SelectionOpacity}">
                                                            <Border.OpacityTransition>
                                                                <ScalarTransition Duration="0:0:0.22" />
                                                            </Border.OpacityTransition>
                                                        </Border>
                                                        <Border Width="46" Height="46" CornerRadius="23"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding State, Converter={StaticResource StateBrush}}"
                                                                ToolTipService.ToolTip="{Binding StatusLabel}">
                                                            <FontIcon Glyph="{Binding StatusGlyph}" FontSize="18"
                                                                      Foreground="White" />
                                                        </Border>
                                                        <Grid Grid.Column="1" RowSpacing="3" VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding UpdatedTime}"
                                                                           FontSize="12" VerticalAlignment="Center"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Preview}" MaxLines="1"
                                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <Border Grid.Column="1" Padding="7,1" CornerRadius="9"
                                                                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolVisibility}}"
                                                                        Background="{Binding State, Converter={StaticResource StateBrush}}">
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                                               Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Spacing="10" Margin="24"
                                                    Visibility="{Binding IsConversationListEmpty, Converter={StaticResource BoolVisibility}}">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="34"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding EmptyConversationListText}"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Style="{StaticResource QuietTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </SplitView.Pane>

                        <SplitView.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="DetailsColumn" Width="300" />
                                </Grid.ColumnDefinitions>

                                <!-- Chat -->
                                <Grid Background="{ThemeResource EndpointChatBackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Background="{ThemeResource EndpointHeaderBrush}"
                                            BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="0,0,0,1">
                                        <Grid MinHeight="58" Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ConversationPaneButton" Visibility="Collapsed"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="ConversationPaneButton_Click"
                                                    AutomationProperties.AutomationId="ConversationPaneButton"
                                                    AutomationProperties.Name="نمایش گفتگوها"
                                                    ToolTipService.ToolTip="نمایش گفتگوها">
                                                <FontIcon Glyph="&#xE700;" FontSize="16" />
                                            </Button>
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                                    Background="{Binding AvatarState, Converter={StaticResource StateBrush}}">
                                                <FontIcon Glyph="&#xE95B;" FontSize="18" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding ConversationHeading}" FontSize="15"
                                                           FontWeight="SemiBold" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ChatState}" FontSize="12"
                                                           Foreground="{ThemeResource EndpointAccentTextBrush}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                            <Button x:Name="DetailsButton" Grid.Column="3"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="DetailsButton_Click"
                                                    AutomationProperties.AutomationId="DetailsButton"
                                                    AutomationProperties.Name="نمایش یا پنهان کردن جزئیات گفتگو"
                                                    ToolTipService.ToolTip="جزئیات گفتگو">
                                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ListView x:Name="ConversationList" Grid.Row="1"
                                              ItemsSource="{Binding Conversation}"
                                              SelectionMode="None" IsItemClickEnabled="False"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent" Padding="0,10,0,10"
                                              AutomationProperties.AutomationId="ConversationTranscript"
                                              AutomationProperties.Name="گفتگوی پشتیبانی">
                                        <ListView.Resources>
                                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                        </ListView.Resources>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>

                                    <Border Grid.Row="2" Background="{ThemeResource EndpointComposerBrush}"
                                            BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="0,1,0,0"
                                            Padding="12,10,12,8">
                                        <Grid RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="MessageInput" FlowDirection="RightToLeft" Language="fa-IR"
                                                         TextReadingOrder="UseFlowDirection" TextAlignment="Right"
                                                         GotFocus="MessageInput_GotFocus"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="44" MaxHeight="120" MaxLength="200"
                                                         Padding="16,11" CornerRadius="22"
                                                         VerticalContentAlignment="Center"
                                                         PlaceholderText="مشکل خود را بنویسید…"
                                                         TextChanged="MessageInput_TextChanged"
                                                         PreviewKeyDown="MessageInput_KeyDown"
                                                         AutomationProperties.AutomationId="MessageInput"
                                                         AutomationProperties.HelpText="حداکثر ۲۰۰ نویسه. Enter برای ارسال؛ Shift+Enter برای خط جدید"
                                                         AutomationProperties.Name="متن درخواست پشتیبانی" />
                                                <Button x:Name="SubmitButton" Grid.Column="1"
                                                        Click="Submit_Click"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Width="44" Height="44" Padding="0" CornerRadius="22"
                                                        VerticalAlignment="Bottom"
                                                        AutomationProperties.AutomationId="SubmitMessageButton"
                                                        AutomationProperties.Name="ارسال پیام"
                                                        ToolTipService.ToolTip="ارسال (Enter)">
                                                    <Grid>
                                                        <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="17"
                                                                  MirroredWhenRightToLeft="True" />
                                                        <ProgressRing x:Name="SendingRing" Width="18" Height="18"
                                                                      IsActive="False" Foreground="White" />
                                                    </Grid>
                                                </Button>
                                                <Button x:Name="ClosedConversationButton" Grid.ColumnSpan="2"
                                                        Visibility="Collapsed" HorizontalAlignment="Stretch"
                                                        MinHeight="44" CornerRadius="22"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Click="NewConversation_Click"
                                                        AutomationProperties.AutomationId="ClosedConversationNewButton">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                        <TextBlock Text="این گفتگو بسته شده است؛ شروع گفتگوی جدید" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="14,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SubmitResult}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           Style="{StaticResource MetadataTextStyle}" />
                                                <TextBlock x:Name="CharacterCount" Grid.Column="1"
                                                           Text="۰ از ۲۰۰" VerticalAlignment="Center"
                                                           AutomationProperties.Name="تعداد نویسه‌های پیام"
                                                           Style="{StaticResource MetadataTextStyle}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Details (physically left): compact so it rarely needs scrolling -->
                                <Border x:Name="DetailsPane" Grid.Column="1"
                                        Background="{ThemeResource EndpointSubtleFillBrush}"
                                        BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Padding="12,12" Spacing="8">
                                            <Grid ColumnSpacing="10" Margin="2,0,2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="22"
                                                        Background="{Binding AvatarState, Converter={StaticResource StateBrush}}">
                                                    <FontIcon Glyph="&#xE95B;" FontSize="20" Foreground="White" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConversationHeading}" FontSize="14"
                                                               FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ConversationSubheading}" MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource MetadataTextStyle}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource DetailsCardStyle}" Padding="12,8">
                                                <Grid ColumnSpacing="8" RowSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="وضعیت" Style="{StaticResource MetadataTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DetailsStatus}" FontSize="13"
                                                               TextWrapping="Wrap" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Row="1" Text="شروع" Style="{StaticResource MetadataTextStyle}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailsCreated}"
                                                               FontSize="13" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Row="2" Text="آخرین فعالیت" Style="{StaticResource MetadataTextStyle}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailsUpdated}"
                                                               FontSize="13" HorizontalAlignment="Left" />
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource DetailsCardStyle}" Padding="12,8">
                                                <Grid ColumnSpacing="8" RowSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Ellipse x:Name="DetailsStatusDot" Width="9" Height="9"
                                                                 Fill="Gray" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                            Width="30" Height="30" CornerRadius="15"
                                                            Click="RefreshStatus_Click"
                                                            ToolTipService.ToolTip="به‌روزرسانی وضعیت"
                                                            AutomationProperties.Name="به‌روزرسانی وضعیت"
                                                            AutomationProperties.AutomationId="RefreshStatusButton">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                    </Button>
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusDetail}"
                                                               MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource MetadataTextStyle}" />
                                                </Grid>
                                            </Border>

                                            <Border Padding="12,10" CornerRadius="12"
                                                    Background="{ThemeResource EndpointNoteBrush}"
                                                    BorderBrush="{ThemeResource EndpointNoteBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE946;" FontSize="13"
                                                                  Foreground="{ThemeResource EndpointNoteTextBrush}" />
                                                        <TextBlock Text="راهنما" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource EndpointNoteTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource EndpointNoteTextBrush}"
                                                               Text="لطفاً نیازی به سلام و احوال‌پرسی با دستیار نیست؛ همان اول، مشکل خود را بنویسید." />
                                                    <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource EndpointNoteTextBrush}" Opacity="0.85"
                                                               Text="هر تغییری روی رایانه، پیش از اجرا از شما تأیید گرفته می‌شود." />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </SplitView.Content>
                    </SplitView>
                </Grid>

                <ScrollViewer x:Name="StatusPage" Visibility="Collapsed" SizeChanged="StatusPage_SizeChanged" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatusContent" HorizontalAlignment="Center" Width="880" Margin="28,20,28,28" Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="وضعیت و کنترل" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="وضعیت سرویس، اتصال و آخرین فعالیت دستیار پشتیبانی را مشاهده کنید."
                                       Style="{StaticResource QuietTextStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource DetailsCardStyle}" Padding="20,18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26"
                                        Background="{ThemeResource EndpointAccentBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="StatusPageDot" Width="10" Height="10" Fill="Gray"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource QuietTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource DetailsCardStyle}" Padding="20,16">
                            <Grid RowSpacing="14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Glyph="&#xE912;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="سرویس" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{Binding Service}" />
                                <FontIcon Grid.Row="1" Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="اتصال" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Connection}" />
                                <FontIcon Grid.Row="2" Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="عملکردها" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FunctionMode}" />
                                <FontIcon Grid.Row="3" Glyph="&#xE823;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="آخرین اتصال" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LastConnected}" />
                                <FontIcon Grid.Row="4" Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="آخرین عملکرد" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LastCommand}" TextWrapping="Wrap" />
                                <FontIcon Grid.Row="5" Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="آخرین مشکل" Style="{StaticResource QuietTextStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding LastProblem}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="10">
                            <TextBlock Text="کنترل سرویس" Style="{StaticResource CardTitleStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button HorizontalAlignment="Stretch" MinHeight="40"
                                        IsEnabled="{Binding CanStart}" Tag="start" Click="ServiceAction_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="راه‌اندازی" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="40"
                                        IsEnabled="{Binding CanPause}" Tag="pause" Click="ServiceAction_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE769;" FontSize="14" /><TextBlock Text="مکث عملکردها" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" MinHeight="40"
                                        IsEnabled="{Binding CanResume}" Tag="resume" Click="ServiceAction_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="ادامه عملکردها" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" HorizontalAlignment="Stretch" MinHeight="40"
                                        IsEnabled="{Binding CanStop}" Tag="stop" Click="ServiceAction_Click"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="توقف سرویس" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding ActionResult}" Style="{StaticResource QuietTextStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="28,20,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="گزارش‌ها" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="فعالیت دستیار پشتیبانی و رویدادهای سرویس را جستجو و بررسی کنید."
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,14,0,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LogSearch" Header="جستجو" PlaceholderText="عبارت مورد نظر"
                                 TextChanged="LogSearch_TextChanged"
                                 AutomationProperties.Name="جستجو در گزارش‌ها" />
                        <ComboBox x:Name="LogLevel" Grid.Column="1" SelectedIndex="0" SelectionChanged="LogFilter_Changed"
                                  Header="سطح" HorizontalAlignment="Stretch" AutomationProperties.Name="سطح گزارش">
                            <ComboBoxItem Content="همه سطح‌ها" /><ComboBoxItem Content="خطا" />
                            <ComboBoxItem Content="هشدار" /><ComboBoxItem Content="اطلاعات" />
                        </ComboBox>
                        <ComboBox x:Name="LogAge" Grid.Column="2" SelectedIndex="1" SelectionChanged="LogFilter_Changed"
                                  Header="بازه زمانی" HorizontalAlignment="Stretch" AutomationProperties.Name="بازه زمانی گزارش">
                            <ComboBoxItem Content="یک ساعت" /><ComboBoxItem Content="۶ ساعت" />
                            <ComboBoxItem Content="۲۴ ساعت" /><ComboBoxItem Content="۷ روز" />
                        </ComboBox>
                        <CommandBar Grid.Column="3" VerticalAlignment="Bottom" Background="Transparent"
                                    DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True">
                            <AppBarButton Label="به‌روزرسانی" Click="RefreshLogs_Click">
                                <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="کپی" Click="CopyLogs_Click">
                                <AppBarButton.Icon><SymbolIcon Symbol="Copy" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="خروجی" Click="ExportLogs_Click">
                                <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>
                    <Border Grid.Row="2" Background="{ThemeResource EndpointSurfaceBrush}"
                            BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource EndpointSubtleFillBrush}" CornerRadius="12,12,0,0"
                                    BorderBrush="{ThemeResource EndpointLineBrush}" BorderThickness="0,0,0,1">
                                <Grid MinHeight="36" ColumnSpacing="12" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" /><ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="150" /><ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="زمان" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="سطح" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="منبع" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="رویداد" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="پیام" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}"
                                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                                      SelectionMode="Single" AutomationProperties.Name="فهرست گزارش‌های دستیار پشتیبانی">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" ColumnSpacing="12" Padding="0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145" /><ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="150" /><ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimestampUtc}" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" TextTrimming="CharacterEllipsis"
                                                       FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding EventId}" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <TextBox Grid.Row="3" Margin="0,12,0,0" Text="{Binding SelectedLogText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono"
                             CornerRadius="12"
                             FlowDirection="RightToLeft" AutomationProperties.Name="جزئیات گزارش انتخاب‌شده" />
                    <TextBlock Grid.Row="4" Text="{Binding LogState}" Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource QuietTextStyle}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
