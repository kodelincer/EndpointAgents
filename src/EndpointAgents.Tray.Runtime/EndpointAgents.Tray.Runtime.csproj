<Project Sdk="Microsoft.NET.Sdk">

  <!-- User-session pieces shared by every Tray front end: the service channel, the catalogued
       task handlers, status resolution, event logging and the notification-area icon. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EndpointAgents.Tray</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
    <ProjectReference Include="..\EndpointAgents.Shared\EndpointAgents.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndpointAgents.Platform.Windows.Tests" />
  </ItemGroup>

</Project>
