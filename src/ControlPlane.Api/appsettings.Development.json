{
  "Urls": "http://localhost:5052",
  "Chat": {
    "DatabasePath": "..\\..\\.local\\control-plane.db",
    "RetentionDays": 30
  },
  "AgentSecurity": {
    "RequireAuthentication": false,
    "RequireHttps": false
  },
  "Hermes": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:8642",
    "ApiKey": "local-hermes-api-0123456789abcdef0123456789",
    "Model": "",
    "McpApiKey": "local-controlplane-mcp-0123456789abcdef0123456789",
    "MaxConcurrentRuns": 4,
    "RunTimeoutSeconds": 600,
    "PollIntervalMilliseconds": 1000,
    "MaxHistoryMessages": 6
  },
  "Dashboard": {
    "AllowedOrigins": [ "http://127.0.0.1:3000", "http://localhost:3000" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
