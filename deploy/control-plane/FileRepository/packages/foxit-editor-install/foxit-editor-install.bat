@echo off
setlocal
rem Installs Foxit PDF Editor for all users from the vendor installer shipped next to this file,
rem unless it is already installed. Runs unattended as LocalSystem.
rem Generated by scripts\new-install-package.ps1 from deploy\package-templates\install-app.bat.
rem Exit codes: 0 installed now, 10 already installed, 3010 installed and a restart
rem is needed, 1 failed. Every success prints "Foxit PDF Editor install completed."

set "APP=Foxit PDF Editor"
rem msi: run through msiexec /qn. exe: run with the fixed silent arguments below.
set "KIND=msi"
set "INSTALLER=%~dp0FoxitPDFEditor.msi"
rem Fixed MSI properties, or the EXE's silent switches, chosen by the administrator.
set INSTALL_ARGS=
rem findstr patterns for the product's DisplayName in the Uninstall registry keys.
set "DETECT=REG_SZ *Foxit PDF Editor\>"
set "DETECT_ALT=REG_SZ *Foxit PhantomPDF\>"
set "LOGDIR=%ProgramData%\EndpointAgents\Logs"
set "LOG=%LOGDIR%\foxit-editor-install.log"

call :find_app
if defined FOUND goto already_installed

if not exist "%INSTALLER%" goto no_installer
if not exist "%LOGDIR%" mkdir "%LOGDIR%"

echo Installing %APP% for all users...
if /i "%KIND%"=="msi" goto run_msi
"%INSTALLER%" %INSTALL_ARGS%
set "RESULT=%ERRORLEVEL%"
goto installed
:run_msi
"%SystemRoot%\System32\msiexec.exe" /i "%INSTALLER%" /qn /norestart /l*v "%LOG%" %INSTALL_ARGS%
set "RESULT=%ERRORLEVEL%"

:installed
echo Installer exit code %RESULT%.
if "%RESULT%"=="1618" goto busy
if "%RESULT%"=="3010" goto verify
if "%RESULT%"=="1641" goto verify
if not "%RESULT%"=="0" goto install_failed

:verify
call :find_app
if not defined FOUND goto missing_after_install
echo %APP% install completed.
if "%RESULT%"=="0" exit /b 0
exit /b 3010

:already_installed
echo %APP% is already installed.
echo %APP% install completed.
exit /b 10

:no_installer
echo ERROR: The %APP% installer is missing from the package.
exit /b 1

:busy
echo ERROR: Another installation is running on this PC. Try again later.
exit /b 1

:install_failed
echo ERROR: The %APP% installer failed with code %RESULT%. See %LOGDIR%.
exit /b 1

:missing_after_install
echo ERROR: The installer finished but %APP% was not found. See %LOGDIR%.
exit /b 1

rem Sets FOUND when an Uninstall entry, 64- or 32-bit, has a matching DisplayName.
:find_app
set "FOUND="
for %%K in ("HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall") do reg query %%K /s /v DisplayName 2>nul | findstr /i /r /c:"%DETECT%" /c:"%DETECT_ALT%" >nul && set "FOUND=1"
exit /b 0
