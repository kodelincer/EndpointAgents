# Copy to C:\ProgramData\EndpointAgents\Hermes\.env and replace every placeholder.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=replace-with-a-random-256-bit-secret
CONTROLPLANE_MCP_KEY=replace-with-a-different-random-256-bit-secret
ENDPOINTAGENTS_MODEL_PROVIDER=openrouter
ENDPOINTAGENTS_MODEL_ID=replace-with-an-agent-capable-model-id

# Configure exactly one supported LLM provider. Example:
# OPENROUTER_API_KEY=replace-with-provider-key
