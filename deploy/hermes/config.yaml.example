# This Hermes home is dedicated to the EndpointAgents API profile.
# It exposes the scoped ControlPlane MCP tools plus Hermes-native skills.
platform_toolsets:
  api_server:
    - mcp-controlplane
    - skills

model:
  provider: ${ENDPOINTAGENTS_MODEL_PROVIDER}
  default: ${ENDPOINTAGENTS_MODEL_ID}

# Defense in depth if a later Hermes release changes a platform default.
agent:
  disabled_toolsets:
    - browser
    - clarify
    - code_execution
    - computer_use
    - cronjob
    - delegation
    - file
    - image_gen
    - kanban
    - memory
    - project
    - safe
    - search
    - session_search
    - terminal
    - todo
    - tts
    - video
    - video_gen
    - vision
    - web
    - x_search

mcp_servers:
  controlplane:
    url: http://127.0.0.1:5052/internal/mcp
    headers:
      Authorization: "Bearer ${CONTROLPLANE_MCP_KEY}"
    enabled: true
    timeout: 660
    connect_timeout: 30
    supports_parallel_tool_calls: false
    tools:
      include:
        - endpoint_get_info
        - endpoint_system_info
        - windows_activation_status
        - office_inventory
        - office_activation_status
        - office_runtime_status
        - run_windows_activation_repair
        - run_office_activation_repair
        - find_repair_packages
        - run_repair_package
        - list_repair_attempts
        - propose_endpoint_action
        - mark_problem_resolved
        - escalate_to_helpdesk
        - request_helpdesk_action
        - record_feature_request
        - list_endpoint_actions
        - list_environment_targets
        - run_endpoint_action
        - check_known_incidents
        - recent_reports_from_others
        - probe_from_server
        - check_user_account
        - note_skill_used
        - get_site_knowledge
      resources: false
      prompts: false
    sampling:
      enabled: false

gateway:
  api_server:
    enabled: true
    host: 127.0.0.1
    port: 8642
    model_name: hermes-agent

memory:
  memory_enabled: false
  user_profile_enabled: false

curator:
  enabled: false

# Skills are created and maintained in this Hermes profile. Endpoint runs may
# list/view them; every model-requested write is staged for an administrator.
skills:
  write_approval: true
  guard_agent_created: true
  # 0 turns off the background review after each run that proposes new skills.
  creation_nudge_interval: 0

plugins:
  enabled: []
